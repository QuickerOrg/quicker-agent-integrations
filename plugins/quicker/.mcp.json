{
  "mcpServers": {
    "quicker": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${PLUGIN_ROOT}/scripts/quicker-mcp.ps1"
      ],
      "startup_timeout_sec": 180,
      "tool_timeout_sec": 180
    }
  }
}
